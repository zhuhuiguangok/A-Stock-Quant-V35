# A股智能选股系统 环境变量配置

# Tushare 接口 Token
# 请前往 https://tushare.pro/ 注册并获取 Token
TUSHARE_TOKEN=

# NLP 模型下载端点与本地目录。Windows 磁盘空间不足时建议放到 D 盘。
# HF_ENDPOINT=https://huggingface.co
# SENTIMENT_MODEL_DIR=D:\stock-quant-models\roberta-jd-binary

# 数据库配置 (如果使用除 SQLite 之外的数据库)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=myuser
# DB_PASSWORD=mypassword

# 框架密钥 (生产环境建议修改)
SECRET_KEY=django-insecure-default-key-for-open-source
